@inherits MudExJsRequiredBaseComponent<MudExFileDisplayColumnarData>

<style>
    .mud-ex-columnar { width:100%;height:100%;position:relative;min-height:0;overflow:auto; }
    .mud-ex-columnar table { border-collapse:collapse;min-width:100%;font-size:.875rem; }
    .mud-ex-columnar th { position:sticky;top:0;background:var(--mud-palette-surface);z-index:1;text-align:left; }
    .mud-ex-columnar th,.mud-ex-columnar td { border-bottom:1px solid rgba(128,128,128,.2);padding:6px 10px;white-space:nowrap; }
    .mud-ex-columnar-overlay { position:absolute;inset:0;display:flex;align-items:center;justify-content:center; }
</style>

<div @ref="ElementReference" class="mud-ex-columnar">
    <div id="@_containerId"></div>
    @if (_loading) { <div class="mud-ex-columnar-overlay"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div> }
    @if (!string.IsNullOrWhiteSpace(_errorMessage)) { <MudAlert Severity="Severity.Error" Class="ma-3">@_errorMessage</MudAlert> }
</div>
