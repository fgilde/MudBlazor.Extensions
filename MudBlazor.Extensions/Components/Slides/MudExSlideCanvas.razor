@inherits MudExBaseComponent<MudExSlideCanvas>
@namespace MudBlazor.Extensions.Components
@using MudBlazor.Extensions.Office.Presentation

<div @ref="_root" @attributes="UserAttributes" class="@($"mud-ex-slide-canvas {Class}".TrimEnd())" style="@Style" tabindex="0" role="application"
     aria-label="@TryLocalize("Slide")" data-readonly="@(ReadOnly ? "true" : "false")" data-selection="@string.Join(",", _selection)"
     data-insert="@_insert" data-cells="@(SelectedCells != null ? "true" : null)" @onkeydown="_keyDown"
     @oncontextmenu="ContextMenu" @oncontextmenu:preventDefault="@(!ReadOnly && _text == null && ContextMenu.HasDelegate)">
    @if (Presentation != null && Slide != null)
    {
        <div class="mud-ex-slide-canvas-frame" style="@FrameStyle" data-width="@Presentation.SlideWidth" data-height="@Presentation.SlideHeight">
            <MudExSlideView Presentation="Presentation" Slide="Slide" Images="Images" Interactive="@(!ReadOnly)" HiddenText="@_text?.Owner" HiddenCell="@_text?.Position" />
            @if (!ReadOnly)
            {
                @if (_text != null)
                {
                    <div class="mud-ex-slide-text-layer">
                        <MudExSlideTextEditor @key="_text" @ref="_textEditor" Presentation="Presentation" Shape="_text.Shape" Text="@_text.Text" Caret="@_text.Caret"
                                              Cell="@(_text.Cell != null)" TextChanged="_textChanged" Committed="_textCommitted" Tabbed="_textTabbed" Localizer="@Localizer" />
                    </div>
                }
                <div class="mud-ex-slide-canvas-layer">
                    @foreach (var shape in SelectedShapes)
                    {
                        var t = shape.ResolvedTransform;
                        var editing = ReferenceEquals(shape, _text?.Owner);
                        <div @key="shape" class="@(editing ? "mud-ex-slide-selection mud-ex-slide-selection-editing" : "mud-ex-slide-selection")" data-id="@shape.Id" data-x="@t.X" data-y="@t.Y" data-w="@t.Width" data-h="@t.Height"
                             data-r="@MudExSlideShapeView.Num(t.Rotation)" data-fh="@(t.FlipH ? "true" : null)" data-fv="@(t.FlipV ? "true" : null)"
                             data-opaque="@(shape is OpaqueShape or TableShape ? "true" : null)" data-cols="@Sizes(shape, true)" data-rows="@Sizes(shape, false)"
                             style="@MudExSlideShapeView.BoxStyle(t, Presentation, false)">
                            @foreach (var handle in editing ? [] : Handles)
                            {
                                <span class="@($"mud-ex-slide-handle mud-ex-slide-handle-{handle}")" data-handle="@handle"></span>
                            }
                            @if (shape is not (OpaqueShape or TableShape) && !editing)
                            {
                                <span class="mud-ex-slide-handle mud-ex-slide-handle-rotate" data-handle="rotate"></span>
                            }
                            @if (shape is TableShape table && !editing && _selection.Count == 1)
                            {
                                var xs = Edges(table.ColumnWidths);
                                var ys = Edges(table.Rows.Select(r => r.Height));
                                @if (SelectedCells is { } range)
                                {
                                    <div class="mud-ex-slide-table-range" style="@RangeStyle(xs, ys, range)"></div>
                                }
                                @for (var i = 1; i < xs.Count; i++)
                                {
                                    <span class="mud-ex-slide-table-grip mud-ex-slide-table-grip-col" data-col="@i" style="@($"left:{MudExSlideShapeView.Num(xs[i])}%")"></span>
                                }
                                @for (var i = 1; i < ys.Count; i++)
                                {
                                    <span class="mud-ex-slide-table-grip mud-ex-slide-table-grip-row" data-row="@i" style="@($"top:{MudExSlideShapeView.Num(ys[i])}%")"></span>
                                }
                                @foreach (var edge in TableEdges)
                                {
                                    <span class="@($"mud-ex-slide-table-edge mud-ex-slide-table-edge-{edge}")"></span>
                                }
                            }
                        </div>
                    }
                    @if (ShowAnimationOrder)
                    {
                        @foreach (var (shape, label) in AnimationOrder())
                        {
                            <span class="mud-ex-slide-animation-badge" data-shape-id="@shape.Id" style="@BadgeStyle(shape)">@label</span>
                        }
                    }
                    <div class="mud-ex-slide-canvas-guides"></div>
                </div>
            }
        </div>
    }
</div>
