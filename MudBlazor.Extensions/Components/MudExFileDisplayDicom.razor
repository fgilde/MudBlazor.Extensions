@inherits MudExBaseComponent<MudExFileDisplayDicom>

<div style="width:100%;height:100%;min-height:0">
    @if (_loading)
    {
        <MudProgressCircular Style="margin:20% 50%" Color="Color.Primary" Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Warning" Class="ma-3">@_errorMessage</MudAlert>
    }
    else if (_preview != null)
    {
        <MudExImageViewer FileDisplayInfos="@_preview" />
    }
</div>
