@inherits MudExJsRequiredBaseComponent<MudExFileDisplayModel3d>
@namespace MudBlazor.Extensions.Components

<style>
    .mud-ex-model3d-viewer {
        width: 100%;
        height: 100%;
        position: relative;
        box-sizing: border-box;
    }

    .mud-ex-model3d-canvas {
        width: 100%;
        height: 100%;
    }

    .mud-ex-model3d-toolbar {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 2;
        display: flex;
        gap: 4px;
    }

    .mud-ex-model3d-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        pointer-events: none;
    }
</style>

<div @ref="ElementReference" class="mud-ex-model3d-viewer">
    <div class="mud-ex-model3d-toolbar">
        <MudTooltip Text="@TryLocalize("Wireframe")">
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Grid4x4" Color="@(Wireframe ? Color.Primary : Color.Default)" OnClick="@ToggleWireframeAsync" />
        </MudTooltip>
        <MudTooltip Text="@TryLocalize("Auto rotate")">
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Rotate90DegreesCcw" Color="@(AutoRotate ? Color.Primary : Color.Default)" OnClick="@ToggleAutoRotateAsync" />
        </MudTooltip>
        <MudTooltip Text="@TryLocalize("Reset view")">
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.CenterFocusStrong" OnClick="@ResetViewAsync" />
        </MudTooltip>
    </div>

    <div id="@_containerId" class="mud-ex-model3d-canvas"></div>

    @if (_isLoading)
    {
        <div class="mud-ex-model3d-overlay">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>@TryLocalize("Loading model...")</MudText>
        </div>
    }
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="ma-2">@_errorMessage</MudAlert>
    }
</div>
