@inherits MudExBaseComponent<MudExDocumentStatusBar>
@namespace MudBlazor.Extensions.Components

<div @attributes="UserAttributes" class="@($"mud-ex-doc-status-bar {Class}".TrimEnd())" style="@Style" role="status">
    <span class="mud-ex-doc-status-words">@TryLocalize(Words == 1 ? "{0} word" : "{0} words", Words)</span>
    <div class="mud-ex-sssb-zoom">
        <button type="button" class="mud-ex-sssb-zoom-button" aria-label="@TryLocalize("Zoom Out")" title="@TryLocalize("Zoom Out")" @onclick="@(() => SetZoomAsync(Zoom - 0.1))">&#x2212;</button>
        <input type="range" class="mud-ex-sssb-slider" min="10" max="500" step="10" value="@Percent" aria-label="@TryLocalize("Zoom")" @onchange="OnSliderChangedAsync" />
        <button type="button" class="mud-ex-sssb-zoom-button" aria-label="@TryLocalize("Zoom In")" title="@TryLocalize("Zoom In")" @onclick="@(() => SetZoomAsync(Zoom + 0.1))">+</button>
        <span class="mud-ex-sssb-percent">@($"{Percent}%")</span>
    </div>
</div>
