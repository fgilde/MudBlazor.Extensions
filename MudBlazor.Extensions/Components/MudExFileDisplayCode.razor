@inherits MudExFileEditorBase<MudExFileDisplayCode>

@if (ReadOnly || LoadFailed)
{
    @if (!string.IsNullOrEmpty(Value))
    {
        <MudExCodeView FullHeight="true" FullWidth="true" Code="@Value" Theme="@Theme" Language="@Language"></MudExCodeView>
    }
}
else
{
    <textarea class="mud-ex-code-editor" spellcheck="false" @bind="Value" @bind:event="oninput" @bind:after="MarkDirtyAsync"></textarea>
}
