@inherits MudExTextField<T>
@using Microsoft.AspNetCore.Components.Rendering
@typeparam T


@if (RenderChipsAdditional == Adornment.Start)
{
    <div class="mud-ex-additional-chip-container-start">
        @RenderDataVisualizer
    </div>
}

@if (SearchFunc == null)
{
    @Inherited()
}
else
{
    @* the popover anchors to its parent element, so it needs the wrapper around the input *@
    <div class="mud-ex-tag-field-suggestions-anchor">
        @Inherited()
        <MudPopover Open="@(_suggestionsOpen && _suggestions.Count > 0)"
                    Fixed="true"
                    Paper="true"
                    AnchorOrigin="Origin.BottomLeft"
                    TransformOrigin="Origin.TopLeft"
                    RelativeWidth="DropdownWidth.Relative"
                    MaxHeight="300">
            <div @onmousedown:preventDefault="true">
                <MudList T="T" Dense="true">
                    @for (var i = 0; i < _suggestions.Count; i++)
                    {
                        var index = i;
                        var suggestion = _suggestions[i];
                        <MudListItem T="T" Text="@ConvertSet(suggestion)"
                                     Class="@(index == _activeSuggestion ? "mud-selected-item" : null)"
                                     data-suggestion="@ConvertSet(suggestion)"
                                     OnClick="@(() => PickAsync(suggestion))" />
                    }
                </MudList>
            </div>
        </MudPopover>
    </div>
}

@if (RenderChipsAdditional == Adornment.End)
{
    <div class="mud-ex-additional-chip-container-end">
        @RenderDataVisualizer
    </div>
}

@code {

    private RenderFragment Inherited() => builder => base.BuildRenderTree(builder);

    private void RenderDataVisualizer(RenderTreeBuilder __builder)
    {
        <div class="mud-chipset @ChipClassname" style="@($"max-width: {ChipsMaxWidth}")">
            @for (int i = 0; i < Math.Min(Values?.Count ?? 0, MaxChips == 0 ? int.MaxValue : MaxChips); i++)
            {

                var value = Values[i];
                var invalid = ChipError(value) != null;
                <MudChip Class="@ClassChip"
                         Style="@(invalid ? ChipInvalidStyleName : ChipStyleName)"
                         data-chip="@ConvertSet(value)"
                         OnClose="@CloseOf(value)"
                         @onmouseover="@(args => HandleOnChipMouseOver(args, value))"
                         @onmouseout="@(args =>HandleOnChipMouseOut(args, value))"
                         Color="@(invalid ? MudBlazor.Color.Error : ChipColor.IsColor ? ChipColor.AsColor : MudBlazor.Color.Default)"
                         Ripple="false"
                         Text="@ConvertSet(value)"
                         Value="@value"
                         Variant="@ChipVariant"
                         Size="@ChipSize"
                         Disabled="@Disabled" />
            }
        </div>

        @if (Values != null && MaxChips != 0 && MaxChips < Values.Count)
        {
            var chipsNotShown = Values.Skip(MaxChips).ToList();
            var tooltipText = string.Join(", ", chipsNotShown);

            <MudTooltip Text="@tooltipText">
                <MudChip Ripple="false"
                         T="T"
                         Text="@($" +{chipsNotShown.Count}")"
                         Style="@ChipStyleName"
                         Color="@(ChipColor.IsColor ? ChipColor.AsColor : MudBlazor.Color.Default)"
                         Variant="@ChipVariant"
                         Size="@ChipSize"
                         Disabled="@Disabled" />
            </MudTooltip>
        }

    }
}