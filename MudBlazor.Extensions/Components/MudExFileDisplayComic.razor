@inherits MudExBaseComponent<MudExFileDisplayComic>

<style>
    .mud-ex-comic { width:100%; height:100%; display:flex; flex-direction:column; min-height:0; }
    .mud-ex-comic-bar { flex:0 0 auto; border-bottom:1px solid rgba(128,128,128,.2); }
    .mud-ex-comic-page { flex:1 1 auto; min-height:0; }
</style>

<div class="mud-ex-comic">
    @if (_loading)
    {
        <MudProgressCircular Style="margin:auto" Color="Color.Primary" Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="ma-3">@_errorMessage</MudAlert>
    }
    else if (_currentPage != null)
    {
        <MudToolBar Dense="true" Class="mud-ex-comic-bar">
            <MudIconButton Icon="@Icons.Material.Filled.FirstPage" Disabled="@(!CanGoBack)" OnClick="@(() => SelectPageAsync(0))" />
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(!CanGoBack)" OnClick="@(() => MoveAsync(-1))" />
            <MudText Typo="Typo.caption">@(_selectedIndex + 1) / @_pages.Count</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(!CanGoForward)" OnClick="@(() => MoveAsync(1))" />
            <MudIconButton Icon="@Icons.Material.Filled.LastPage" Disabled="@(!CanGoForward)" OnClick="@(() => SelectPageAsync(_pages.Count - 1))" />
            <MudSpacer />
            <MudText Typo="Typo.caption">@_pages[_selectedIndex].Name</MudText>
        </MudToolBar>
        <div class="mud-ex-comic-page">
            <MudExImageViewer FileDisplayInfos="@_currentPage" ShowNavigator="false" />
        </div>
    }
</div>
