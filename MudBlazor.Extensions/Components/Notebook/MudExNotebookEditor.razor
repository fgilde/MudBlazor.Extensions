@inherits MudBlazor.Extensions.Components.Base.MudExFileEditorBase<MudExNotebookEditor>
@namespace MudBlazor.Extensions.Components
@using MudBlazor.Extensions.Office.Notebook

<div @ref="_root" @attributes="UserAttributes" class="@($"mud-ex-notebook-editor {Class}".TrimEnd())" style="@RootStyle" data-readonly="@(IsReadOnly ? "true" : "false")" @onkeydown="_keyDown">
    @if (ShowRibbon)
    {
        <MudExRibbon Class="mud-ex-notebook-ribbon" Color="@RibbonColor" @bind-ActiveTabIndex="_tabIndex" @bind-Mode="_mode" @bind-Collapsed="_collapsed" FileMenuText="@TryLocalize("File")">
            <FileMenu>
                <MudExFileEditorBackstage Editor="this" Localizer="@Localizer" />
            </FileMenu>
            <QuickAccess>
                @if (!IsReadOnly)
                {
                    <MudExRibbonButton Id="nb-save" Text="@TryLocalize("Save")" Icon="@Icons.Material.Filled.Save" Shortcut="Ctrl+S" OnClick="@(() => SaveAsync())" />
                    <MudExRibbonButton Id="nb-undo" Text="@TryLocalize("Undo")" Icon="@Icons.Material.Filled.Undo" Shortcut="Ctrl+Z" Disabled="@(!_notebook.Undo.CanUndo)" OnClick="@(() => UndoAsync(false))" />
                    <MudExRibbonButton Id="nb-redo" Text="@TryLocalize("Redo")" Icon="@Icons.Material.Filled.Redo" Shortcut="Ctrl+Y" Disabled="@(!_notebook.Undo.CanRedo)" OnClick="@(() => UndoAsync(true))" />
                }
            </QuickAccess>
            <ChildContent>
                <MudExRibbonTab Text="@TryLocalize("Home")" KeyTip="H" Visible="@(!IsReadOnly)">
                    @Group("Clipboard", Icons.Material.Filled.ContentPaste, 3, ClipboardItems)
                    <MudExRibbonGroup Text="@TryLocalize("Font")" Icon="@Icons.Material.Filled.FormatSize" CollapsePriority="2">
                        <MudExRibbonRow>
                            <MudExRibbonSelect T="string" Id="nb-font" Text="@TryLocalize("Font")" Items="@Fonts" Value="@(TextState?.Font ?? Fonts[0])" ValueChanged="SetFontAsync" Editable="true" Width="140" Disabled="@(!CanFormat)" />
                            <MudExRibbonNumberBox Id="nb-font-size" Text="@TryLocalize("Font Size")" Value="@(TextState?.SizePt ?? 11)" ValueChanged="SetFontSizeAsync" Min="1" Max="1000" Step="1" Disabled="@(!CanFormat)" />
                        </MudExRibbonRow>
                        <MudExRibbonRow>
                            @foreach (var (id, text, icon, shortcut, key) in FontToggles)
                            {
                                <MudExRibbonToggleButton Id="@id" Text="@TryLocalize(text)" Icon="@icon" Shortcut="@shortcut" Size="MudExRibbonItemSize.Small" Disabled="@(!CanFormat)"
                                                         Checked="@IsOn(key)" CheckedChanged="@(_ => FormatAsync(key, null))" />
                            }
                            <MudExRibbonColorPicker Id="nb-highlight" Text="@TryLocalize("Highlight")" Icon="@Icons.Material.Filled.BorderColor" Size="MudExRibbonItemSize.Small" Palette="@HighlightPalette"
                                                    Disabled="@(!CanFormat)" ValueChanged="SetHighlightAsync" />
                            <MudExRibbonColorPicker Id="nb-font-color" Text="@TryLocalize("Font Color")" Icon="@Icons.Material.Filled.FormatColorText" Size="MudExRibbonItemSize.Small" Palette="@Palette"
                                                    Disabled="@(!CanFormat)" ValueChanged="SetFontColorAsync" />
                        </MudExRibbonRow>
                    </MudExRibbonGroup>
                    <MudExRibbonGroup Text="@TryLocalize("Paragraph")" Icon="@Icons.Material.Filled.FormatListBulleted" CollapsePriority="4">
                        <MudExRibbonRow>
                            @foreach (var (id, text, icon, shortcut, list) in ListToggles)
                            {
                                <MudExRibbonToggleButton Id="@id" Text="@TryLocalize(text)" Icon="@icon" Shortcut="@shortcut" Size="MudExRibbonItemSize.Small" Disabled="@(!CanFormat)"
                                                         Checked="@(TextState?.List == list)" CheckedChanged="@(_ => SetListAsync(list))" />
                            }
                            <MudExRibbonButton Id="nb-outdent" Text="@TryLocalize("Decrease Indent")" Icon="@Icons.Material.Filled.FormatIndentDecrease" Shortcut="Shift+Tab" Size="MudExRibbonItemSize.Small"
                                               Disabled="@(!CanFormat)" OnClick="@(() => FormatAsync("indent", "-1"))" />
                            <MudExRibbonButton Id="nb-indent" Text="@TryLocalize("Increase Indent")" Icon="@Icons.Material.Filled.FormatIndentIncrease" Shortcut="Tab" Size="MudExRibbonItemSize.Small"
                                               Disabled="@(!CanFormat)" OnClick="@(() => FormatAsync("indent", "1"))" />
                        </MudExRibbonRow>
                        <MudExRibbonRow>
                            @foreach (var (id, text, icon, shortcut, align) in AlignToggles)
                            {
                                <MudExRibbonToggleButton Id="@id" Text="@TryLocalize(text)" Icon="@icon" Shortcut="@shortcut" Size="MudExRibbonItemSize.Small" Disabled="@(!CanFormat)"
                                                         Checked="@(TextState?.Align == align)" CheckedChanged="@(_ => FormatAsync("align", align.ToString().ToLowerInvariant()))" />
                            }
                        </MudExRibbonRow>
                    </MudExRibbonGroup>
                    <MudExRibbonGroup Text="@TryLocalize("Styles")" Icon="@Icons.Material.Filled.Title" CollapsePriority="1">
                        @foreach (var (id, text, heading) in HeadingToggles)
                        {
                            <MudExRibbonToggleButton Id="@id" Text="@TryLocalize(text)" Icon="@(heading == NoteHeading.None ? Icons.Material.Filled.TextFields : Icons.Material.Filled.Title)"
                                                     Size="MudExRibbonItemSize.Small" Disabled="@(!CanFormat)" Checked="@(TextState?.Heading == heading)"
                                                     CheckedChanged="@(_ => FormatAsync("heading", ((int)heading).ToString(System.Globalization.CultureInfo.InvariantCulture)))" />
                        }
                    </MudExRibbonGroup>
                </MudExRibbonTab>
                <MudExRibbonTab Text="@TryLocalize("Insert")" KeyTip="N" Visible="@(!IsReadOnly)">
                    @Group("Tables", Icons.Material.Filled.TableChart, 2, TableItems)
                    @Group("Images", Icons.Material.Filled.Image, 2, ImageItems)
                    @Group("Illustrations", Icons.Material.Filled.Category, 1, ShapeItems)
                    <MudExRibbonGroup Text="@TryLocalize("Links")" Icon="@Icons.Material.Filled.Link" CollapsePriority="0">
                        <MudExRibbonButton Id="nb-insert-link" Text="@TryLocalize("Link")" Icon="@Icons.Material.Filled.Link" Shortcut="Ctrl+K" Size="MudExRibbonItemSize.Large" Disabled="@(!CanLink)"
                                           OnClick="InsertLinkAsync" />
                    </MudExRibbonGroup>
                </MudExRibbonTab>
                <MudExRibbonTab Text="@TryLocalize("Draw")" KeyTip="D" Visible="@(!IsReadOnly)">
                    <MudExRibbonGroup Text="@TryLocalize("Tools")" Icon="@Icons.Material.Filled.Draw" CollapsePriority="0">
                        @foreach (var (id, text, icon, tool) in DrawItems)
                        {
                            <MudExRibbonToggleButton Id="@id" Text="@TryLocalize(text)" Icon="@icon" Size="MudExRibbonItemSize.Large" Disabled="@(!CanEditPage)"
                                                     Checked="@(_tool == tool)" CheckedChanged="@(_ => SetToolAsync(tool))" />
                        }
                    </MudExRibbonGroup>
                    <MudExRibbonGroup Text="@TryLocalize("Pens")" Icon="@Icons.Material.Filled.Edit" CollapsePriority="2">
                        <MudExRibbonGallery TItem="NotebookInkPreset" Id="nb-draw-pens" Text="@TryLocalize("Pens")" Icon="@Icons.Material.Filled.Edit" Size="MudExRibbonItemSize.Large" Columns="6"
                                            Items="InkPresets" ItemText="@(p => TryLocalize(p.Name))" SelectedItem="@CurrentPreset" SelectedItemChanged="ChoosePresetAsync" Disabled="@(!CanEditPage)">
                            <ItemTemplate>
                                <svg class="mud-ex-notebook-pen-preview" viewBox="0 0 32 32" aria-hidden="true">
                                    <path d="M4 22C10 8 16 28 28 10" fill="none" stroke="@context.Color" stroke-width="@NotebookStyles.Num(Math.Min(context.Width, 10))" stroke-linecap="round"
                                          opacity="@(context.Tool == NotebookTool.Highlighter ? "0.5" : "1")" />
                                </svg>
                            </ItemTemplate>
                        </MudExRibbonGallery>
                        <MudExRibbonColorPicker Id="nb-draw-color" Text="@TryLocalize("Color")" Icon="@Icons.Material.Filled.Palette" Size="MudExRibbonItemSize.Small" Palette="@Palette"
                                                Disabled="@(!CanEditPage || !IsInkTool)" ValueChanged="SetInkColor" />
                        <MudExRibbonNumberBox Id="nb-draw-width" Text="@TryLocalize("Thickness")" Value="@Ink.Width" ValueChanged="SetInkWidth" Min="0.5" Max="100" Step="0.5" Unit="px"
                                              Disabled="@(!CanEditPage || !IsInkTool)" />
                    </MudExRibbonGroup>
                </MudExRibbonTab>
                <MudExRibbonTab Text="@TryLocalize("View")" KeyTip="W">
                    <MudExRibbonGroup Text="@TryLocalize("Show")" Icon="@Icons.Material.Filled.Visibility" CollapsePriority="1">
                        <MudExRibbonToggleButton Id="nb-show-page-list" Text="@TryLocalize("Page List")" Icon="@Icons.Material.Filled.ViewSidebar" Size="MudExRibbonItemSize.Large" @bind-Checked="_pageListVisible" />
                        <MudExRibbonToggleButton Id="nb-show-section-tabs" Text="@TryLocalize("Section Tabs")" Icon="@Icons.Material.Filled.Tab" Size="MudExRibbonItemSize.Large" @bind-Checked="_sectionTabsVisible" />
                    </MudExRibbonGroup>
                    <MudExRibbonGroup Text="@TryLocalize("Zoom")" Icon="@Icons.Material.Filled.ZoomIn" CollapsePriority="2">
                        <MudExRibbonSelect T="double" Id="nb-zoom" Text="@TryLocalize("Zoom")" Items="@ZoomLevels" ItemText="@(z => $"{z * 100:0}%")" Value="@_zoom" ValueChanged="SetZoom" Width="80" />
                        <MudExRibbonButton Id="nb-zoom-100" Text="@TryLocalize("100%")" Icon="@Icons.Material.Filled.ZoomOutMap" Size="MudExRibbonItemSize.Large" OnClick="@(() => SetZoom(1))" />
                    </MudExRibbonGroup>
                </MudExRibbonTab>
                @RibbonContent
            </ChildContent>
        </MudExRibbon>
    }
    @if (_notebook != null && _sectionTabsVisible)
    {
        <MudExNotebookSectionTabs @ref="_tabs" Notebook="_notebook" Current="_section" ReadOnly="IsReadOnly" CurrentChanged="ShowSectionAsync" AddRequested="AddSectionAsync"
                                  CommandRequested="RunCommandAsync" KeyDown="_sectionsKeyDown" Localizer="@Localizer" />
    }
    <div class="mud-ex-notebook-editor-body">
        <div class="mud-ex-notebook-editor-main">
            <div class="mud-ex-notebook-editor-surface" tabindex="0" @onkeydown="_surfaceKeyDown">
                @if (_page != null)
                {
                    <div class="mud-ex-notebook-page-header">
                        @if (CanEditPage)
                        {
                            <input @key="_page" @ref="_titleInput" class="mud-ex-notebook-title" value="@_page.Title" placeholder="@TryLocalize("Untitled page")" aria-label="@TryLocalize("Page title")"
                                   @oninput="_titleInputChanged" @onchange="OnTitleChangedAsync" @onkeydown="_keyDown" @onkeydown:stopPropagation="true" />
                        }
                        else
                        {
                            <h1 class="mud-ex-notebook-title mud-ex-notebook-title-static">@_page.Title</h1>
                        }
                        <div class="mud-ex-notebook-page-date">@_page.Created.ToLocalTime().ToString("f", System.Globalization.CultureInfo.CurrentCulture)</div>
                    </div>
                    <MudExNotebookCanvas @ref="_canvas" Notebook="_notebook" Page="_page" Zoom="_zoom" ReadOnly="@(!CanEditPage)" Tool="_tool" InkColor="@Ink.Color" InkWidth="@Ink.Width" ViewportWidth="_viewport.Width"
                                         ViewportHeight="_viewport.Height" Images="_images" SelectionChanged="OnCanvasSelectionChanged" TextInput="MarkDirtyAsync"
                                         LinkRequested="OpenLinkDialogAsync" Localizer="@Localizer" />
                }
            </div>
        </div>
        @if (_section != null && _pageListVisible)
        {
            <MudExNotebookPageList Section="_section" Current="_page" ReadOnly="IsReadOnly" CurrentChanged="ShowPageAsync" AddRequested="AddPageAsync" RenameRequested="RenamePageAsync"
                                   CommandRequested="RunCommandAsync" KeyDown="_pagesKeyDown" Localizer="@Localizer" />
        }
    </div>
    <MudExNotebookStatusBar SectionName="@_section?.Name" PageNumber="@(PageIndex + 1)" PageCount="@(_section?.Pages.Count ?? 0)" Zoom="_zoom" ZoomChanged="SetZoom" Localizer="@Localizer" />
</div>

@code {
    private RenderFragment Group(string text, string icon, int collapsePriority, (string Id, string Text, string Icon)[] items) =>
        @<MudExRibbonGroup Text="@TryLocalize(text)" Icon="@icon" CollapsePriority="collapsePriority">
            @foreach (var (id, itemText, itemIcon) in items)
            {
                <MudExRibbonButton Id="@id" Text="@TryLocalize(itemText)" Icon="@itemIcon" Size="@(items.Length == 1 ? MudExRibbonItemSize.Large : MudExRibbonItemSize.Small)" Disabled="true" />
            }
        </MudExRibbonGroup>;
}
