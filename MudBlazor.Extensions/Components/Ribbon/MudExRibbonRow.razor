@namespace MudBlazor.Extensions.Components
@inherits MudExRibbonItemBase

<CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>

@code {
    /// <inheritdoc />
    public override RenderFragment Render(MudExRibbonItemLayout layout) => layout == MudExRibbonItemLayout.MenuEntry
        ? MenuEntries(Items)
        : @<div class="mud-ex-ribbon-row">
            @foreach (var item in Items.Where(i => i.Visible))
            {
                <div @key="item" class="mud-ex-ribbon-slot">@item.Render(ChildLayout(item, layout))</div>
            }
        </div>;
}
