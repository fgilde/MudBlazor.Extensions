@namespace MudBlazor.Extensions.Components
@inherits MudExRibbonItemBase

<CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>

@code {
    /// <inheritdoc />
    public override RenderFragment Render(MudExRibbonItemLayout layout)
    {
        if (_items.Any(i => i.Visible))
            return RenderMenu(layout, _items, null);
        return layout == MudExRibbonItemLayout.MenuEntry
            ? MenuEntry(ExecuteCommandAsync, Checked)
            : WithTooltip(layout, Face(layout, ExecuteCommandAsync, Checked));
    }
}
