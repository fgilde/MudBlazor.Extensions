@namespace MudBlazor.Extensions.Components
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@{
    Ribbon.BeginViewRender();
    var activeTab = Ribbon.ActiveTab;
}

<div class="mud-ex-ribbon-header" style="@Ribbon.HeaderStyle">
    @if (Ribbon.TitleContent != null)
    {
        <div class="mud-ex-ribbon-title">@Ribbon.TitleContent</div>
    }
    <div class="mud-ex-ribbon-tabs" role="tablist">
        @foreach (var tab in Ribbon.VisibleTabs)
        {
            var active = tab == activeTab;
            <button @key="tab"
                    type="button"
                    role="tab"
                    id="@TabId(tab)"
                    aria-controls="@PanelId"
                    class="@($"mud-ex-ribbon-tab{(active ? " mud-ex-ribbon-tab-active" : "")}")"
                    aria-selected="@(active ? "true" : "false")"
                    @onclick="() => Ribbon.SelectTabAsync(tab)">
                @tab.Text
            </button>
        }
    </div>
    @if (Ribbon.HeaderEndContent != null)
    {
        <div class="mud-ex-ribbon-header-end">@Ribbon.HeaderEndContent</div>
    }
</div>
<div class="mud-ex-ribbon-body" role="tabpanel" id="@PanelId" aria-labelledby="@(activeTab == null ? null : TabId(activeTab))">
    @foreach (var group in activeTab?.Groups ?? [])
    {
        <div @key="group" class="mud-ex-ribbon-group" role="toolbar" aria-label="@group.Text">
            <div class="mud-ex-ribbon-group-items">
                @foreach (var item in group.Items.Where(i => i.Visible))
                {
                    <div @key="item" class="mud-ex-ribbon-slot">@item.Render(item.DeclaredLayout)</div>
                }
            </div>
            <div class="mud-ex-ribbon-group-title">
                <span>@group.Text</span>
                @if (group.OnDialogLauncherClick.HasDelegate)
                {
                    <button type="button"
                            class="mud-ex-ribbon-dialog-launcher"
                            aria-label="@Ribbon.TryLocalize("More options: {0}", group.Text)"
                            @onclick="() => group.OnDialogLauncherClick.InvokeAsync()">
                        <MudIcon Icon="@Icons.Material.Filled.SouthEast" Class="mud-ex-ribbon-icon" />
                    </button>
                }
            </div>
        </div>
    }
</div>
