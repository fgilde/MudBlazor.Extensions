@namespace MudBlazor.Extensions.Components
@inherits MudExRibbonViewBase
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]

@Tabbed(Body, null)

@code {
    private RenderFragment Body(MudExRibbonTab tab) =>
        @<text>
            @foreach (var group in tab.Groups)
            {
                <div @key="group" class="mud-ex-ribbon-group" role="toolbar" aria-label="@group.Text">
                    <div class="mud-ex-ribbon-group-items">@MudExRibbonItemBase.Slots(group.Items, item => item.DeclaredLayout)</div>
                    <div class="mud-ex-ribbon-group-title">
                        <span>@group.Text</span>
                        @if (group.OnDialogLauncherClick.HasDelegate)
                        {
                            <button type="button"
                                    class="mud-ex-ribbon-dialog-launcher"
                                    aria-label="@Ribbon.TryLocalize("More options: {0}", group.Text)"
                                    @onclick="() => LaunchDialogAsync(group)">
                                <MudIcon Icon="@Icons.Material.Filled.SouthEast" Class="mud-ex-ribbon-icon" />
                            </button>
                        }
                    </div>
                </div>
            }
        </text>;

    private async Task LaunchDialogAsync(MudExRibbonGroup group)
    {
        await group.OnDialogLauncherClick.InvokeAsync();
        Ribbon.NotifyCommandExecuted();
    }
}
