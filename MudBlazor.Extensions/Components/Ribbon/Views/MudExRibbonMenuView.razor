@namespace MudBlazor.Extensions.Components
@inherits MudExRibbonViewBase
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]

@Header(Bar)

@code {
    private RenderFragment Bar =>
        @<div class="mud-ex-ribbon-menubar">
            @foreach (var tab in Ribbon.VisibleTabs)
            {
                <MudMenu @key="tab" Class="mud-ex-ribbon-menubar-menu" Label="@tab.Text" Color="Color.Inherit" Dense="true">
                    @foreach (var (group, index) in tab.Groups.Select((group, index) => (group, index)))
                    {
                        if (index > 0)
                        {
                            <MudDivider Class="mud-ex-ribbon-menu-section-divider" />
                        }
                        <div class="mud-ex-ribbon-menu-subheader">@group.Text</div>
                        @MudExRibbonItemBase.MenuEntries(group.Items)
                    }
                </MudMenu>
            }
        </div>;
}
