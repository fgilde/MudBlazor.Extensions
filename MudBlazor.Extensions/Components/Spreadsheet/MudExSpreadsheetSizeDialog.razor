@inherits MudExBaseComponent<MudExSpreadsheetSizeDialog>
@namespace MudBlazor.Extensions.Components

<MudDialog Class="mud-ex-sssize-dialog">
    <DialogContent>
        <MudNumericField T="double" Class="mud-ex-sssize-value" Label="@TryLocalize(Label)" @bind-Value="_value" Min="0" Max="@Max" Step="1" Format="0.##"
                         Immediate="true" Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@TryLocalize("Cancel")</MudButton>
        <MudButton Class="mud-ex-sssize-ok" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_value < 0 || _value > Max)" OnClick="Ok">@TryLocalize("OK")</MudButton>
    </DialogActions>
</MudDialog>
