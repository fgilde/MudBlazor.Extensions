@inherits MudExBaseComponent<MudExFileDisplayPresentation>

<style>
    .mud-ex-pptx-viewer {
        width: 100%;
        height: 100%;
        display: flex;
        box-sizing: border-box;
    }

    .mud-ex-pptx-thumbnails {
        width: 176px;
        min-width: 140px;
        overflow-y: auto;
        padding: 8px;
        border-right: 1px solid rgba(128, 128, 128, 0.2);
    }

    .mud-ex-pptx-thumbnail {
        cursor: pointer;
        margin-bottom: 8px;
        border: 2px solid transparent;
        border-radius: 2px;
    }

    .mud-ex-pptx-thumbnail.selected {
        border-color: var(--mud-palette-primary);
    }

    .mud-ex-pptx-thumbnail-number {
        font-size: 0.7rem;
        opacity: .6;
        text-align: center;
    }

    .mud-ex-pptx-main {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: auto;
    }

    .mud-ex-pptx-nav {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 8px;
        border-bottom: 1px solid rgba(128, 128, 128, 0.2);
    }

    /* The stage is the container query container - every shape inside sizes itself in cqw of the slide width */
    .mud-ex-pptx-stage {
        container-type: inline-size;
        width: 100%;
        padding: 12px;
        box-sizing: border-box;
    }

    .mud-ex-pptx-slide {
        position: relative;
        width: 100%;
        overflow: hidden;
        background: #ffffff;
        color: #1a1a1a;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.25);
    }

    .mud-ex-pptx-shape {
        position: absolute;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-sizing: border-box;
    }

    .mud-ex-pptx-image {
        position: absolute;
        object-fit: contain;
    }

    .mud-ex-pptx-paragraph {
        margin: 0;
        line-height: 1.25;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .mud-ex-pptx-notes {
        padding: 8px 20px 20px 20px;
        white-space: pre-wrap;
    }
</style>

<div class="mud-ex-pptx-viewer">
    @if (_presentation != null)
    {
        <div class="mud-ex-pptx-thumbnails">
            @foreach (var slide in _presentation.Slides)
            {
                <div class="mud-ex-pptx-thumbnail @(slide == _selected ? "selected" : "")" @onclick="@(() => _selected = slide)">
                    <div class="mud-ex-pptx-stage" style="padding: 0;">
                        <div class="mud-ex-pptx-slide" style="aspect-ratio: @AspectRatio;">
                            @((MarkupString)slide.Html)
                        </div>
                    </div>
                    <div class="mud-ex-pptx-thumbnail-number">@slide.Number</div>
                </div>
            }
        </div>

        <div class="mud-ex-pptx-main">
            <div class="mud-ex-pptx-nav">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(!CanGoBack)" OnClick="@(() => Move(-1))" />
                <MudText Typo="Typo.caption">@(SelectedIndex + 1) / @_presentation.Slides.Count</MudText>
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(!CanGoForward)" OnClick="@(() => Move(1))" />
                <MudSpacer />
                <MudText Typo="Typo.caption">@_selected?.Title</MudText>
            </div>

            @if (_selected != null)
            {
                <div class="mud-ex-pptx-stage">
                    <div class="mud-ex-pptx-slide" style="aspect-ratio: @AspectRatio;">
                        @((MarkupString)_selected.Html)
                    </div>
                </div>
                @if (ShowNotes && !string.IsNullOrWhiteSpace(_selected.Notes))
                {
                    <div class="mud-ex-pptx-notes">
                        <MudText Typo="Typo.overline">@TryLocalize("Notes")</MudText>
                        <MudText Typo="Typo.body2">@_selected.Notes</MudText>
                    </div>
                }
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }
    else
    {
        <MudProgressCircular Style="margin-top: 20%; margin-left: 50%;" Color="Color.Primary" Indeterminate="true" />
    }
</div>
