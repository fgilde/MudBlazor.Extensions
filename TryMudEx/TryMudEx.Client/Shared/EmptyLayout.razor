@using Playzor.Blazor.Core
@using TryMudEx.Client.Services
@using Microsoft.JSInterop
@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider Theme="@LayoutService.Theme" IsDarkMode="@LayoutService.IsDarkMode" />
<MudPopoverProvider />
<div class="main">
	<div class="content px-4">
		@Body
	</div>
</div>

@code {
	[Inject] private LayoutService LayoutService { get; set; }
	[Inject] private NavigationManager NavigationManager { get; set; }
	[Inject] private IJSRuntime JsRuntime { get; set; }

	private DotNetObjectReference<EmptyLayout> _selfRef;

	protected override async Task OnInitializedAsync()
	{
	    if (NavigationManager.Uri.Contains("?dark") || NavigationManager.Uri.Contains("?light"))
	    {
			await LayoutService.ApplyUserPreferences(NavigationManager.Uri.Contains("?dark"), true);
	    }
	    else
	    {
	        await LayoutService.ApplyUserPreferences(false);
	    }
	    await base.OnInitializedAsync();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		// this layout carries the preview iframe, which is its own wasm instance: theme changes
		// in the repl around it can only arrive as a message
		if (firstRender)
		{
			try
			{
				_selfRef = DotNetObjectReference.Create(this);
				await JsRuntime.InvokeVoidAsync(PlayzorJs.Preview.Listen, _selfRef);
			}
			catch { /* without the listener the preview simply keeps the theme it loaded with */ }
		}
		await base.OnAfterRenderAsync(firstRender);
	}

	[JSInvokable]
	public void SetDarkMode(bool dark)
	{
		if (LayoutService.IsDarkMode == dark) return;
		LayoutService.SetDarkMode(dark);
		StateHasChanged();
	}

	public void Dispose() => _selfRef?.Dispose();
}
