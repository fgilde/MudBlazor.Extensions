@page "/snippet/{snippetId?}"
@page "/snippet/samples/{sample?}"
@page "/snippet/from/{snippetFileUrl?}"
@using MudBlazor.Extensions.Core
@using Try.Core

@layout MainLayout

<div class="try-layout d-flex flex-column" style="height:100%">
    <MudAppBar Dense="true" Fixed="false" Elevation="1" Class="repl-toolbar" Style="position:relative;">
        <MudTooltip Text="Run (Ctrl + S)">
            <MudIconButton OnClick="@CompileAsync" Disabled="@Loading" Icon="@Icons.Material.Rounded.PlayArrow" Color="Color.Success" />
        </MudTooltip>
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
        <MudTooltip Text="Save or Share">
            <MudIconButton OnClick="ShowSaveSnippetPopup" Icon="@Icons.Material.Outlined.Save" />
        </MudTooltip>
        <SaveSnippetPopup @bind-Visible="SaveSnippetPopupVisible" CodeFiles="@CodeFiles.Values" UpdateActiveCodeFileContentAction="CollectAllEditorContent" />
        <MudTooltip Text="Download">
            <MudIconButton OnClick="Download" Icon="@Icons.Material.Outlined.Download" />
        </MudTooltip>
        <MudTooltip Text="Upload">
            <MudIconButton OnClick="Upload" Icon="@Icons.Material.Outlined.UploadFile" />
        </MudTooltip>
        @if (_samples?.Any() == true)
        {
            <MudTooltip Text="Samples">
                <MudIconButton OnClick="@ShowSamples" Icon="@Icons.Material.Outlined.Folder" />
            </MudTooltip>
        }
        <MudTooltip Text="Manage Nuget packages">
            <MudIconButton Icon="@MudExIcons.Custom.Brands.Nuget" OnClick="@(() => EditPackageReferences(false))" />
        </MudTooltip>
        <MudSpacer />
        <MudMenu Dense="true" CloseOnClickOutside="true">
            <ActivatorContent>
                <MudTooltip Text="Panels">
                    <MudIconButton Icon="@Icons.Material.Outlined.GridView" />
                </MudTooltip>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@(() => TogglePanel("files"))">Files</MudMenuItem>
                <MudMenuItem OnClick="@(() => TogglePanel("errors"))">Errors</MudMenuItem>
                <MudMenuItem OnClick="@(() => TogglePanel("console"))">Console</MudMenuItem>
                <MudMenuItem OnClick="@ResetLayout">Reset layout</MudMenuItem>
            </ChildContent>
        </MudMenu>
        <MudTooltip Text="@(LayoutService.IsDarkMode ? "Switch to Light Theme" : "Switch to Dark Theme")">
            <MudIconButton OnClick="@UpdateTheme" Icon="@(LayoutService.IsDarkMode ? @Icons.Material.Rounded.LightMode : @Icons.Material.Outlined.DarkMode)" />
        </MudTooltip>
        <div class="brand ml-2"><MudExGradientText Typo="Typo.h6">MudEx</MudExGradientText></div>
    </MudAppBar>

    <div class="try-editor flex-grow-1" style="position:relative; min-height:0;">
        <MudOverlay Visible="Loading" Absolute="true" DarkBackground="true">
            <MudText Typo="Typo.h4" Class="white-text"> @LoaderText</MudText>
        </MudOverlay>

        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="false">
            <MudExDockLayout @ref="_dock" Id="try-dock" ContainerStyle="height:100%;width:100%;min-height:300px;"
                             InitialLayoutJson="@_initialLayoutJson"
                             OnPanelRemoved="HandlePanelRemoved" OnPanelMoved="HandlePanelMoved" OnActiveChanged="HandleActivePanelChanged">
                @* first panel becomes the grid base (center). __Main.razor always exists and is never closable. *@
                <MudExDockItem Id="@MainEditorPanelId" Title="@CoreConstants.MainComponentFilePath" CanClose="false" Renderer="DockRendererMode.Always">
                    <CodeEditor Id="@EditorDomId(CoreConstants.MainComponentFilePath)" Theme="@EditorTheme"
                                Code="@GetFile(CoreConstants.MainComponentFilePath)?.Content" CodeFileType="CodeFileType.Razor" />
                </MudExDockItem>
                <MudExDockItem Id="files" Title="Files" Direction="DockDirection.Left" InitialWidth="230" Renderer="DockRendererMode.Always">
                    <FileTree Files="@CodeFiles.Values" ActivePath="@activeCodeFile?.Path" ShowHiddenFiles="@ShowHiddenFiles"
                              OnOpen="OpenFile" OnCreate="HandleCreateFile" OnCreateFromTemplate="HandleCreateFromTemplate"
                              OnRename="HandleRenameFile" OnDelete="HandleDeleteFile" />
                </MudExDockItem>
                <MudExDockItem Id="preview" Title="Preview" Direction="DockDirection.Right" CanClose="false" Renderer="DockRendererMode.Always">
                    <iframe style="height:100%; width:100%; border:none;" id="user-page-window" data-base-src="/user-page" src="/user-page"></iframe>
                </MudExDockItem>
                <MudExDockItem Id="errors" Title="Errors" Direction="DockDirection.Below" InitialHeight="170" Renderer="DockRendererMode.Always">
                    <ErrorList OnDiagnosticClick="OpenDiagnostic" Show="true" Diagnostics="@Diagnostics" />
                </MudExDockItem>
                <MudExDockItem Id="console" Title="Console" StackWith="errors" Renderer="DockRendererMode.Always">
                    <ConsolePanel />
                </MudExDockItem>
                @* editor items MUST stay last & append-only (tombstones keep positions stable):
                   dockview adopts the nodes, positional re-diffing must never touch existing ones *@
                @foreach (var path in _openFiles)
                {
                    @if (path != null)
                    {
                        <MudExDockItem Id="@EditorPanelId(path)" Title="@FileTitle(path)" StackWith="@MainEditorPanelId" Renderer="DockRendererMode.Always">
                            <CodeEditor Id="@EditorDomId(path)" Theme="@EditorTheme" Code="@GetFile(path)?.Content" CodeFileType="@(GetFile(path)?.Type ?? CodeFileType.Razor)" />
                        </MudExDockItem>
                    }
                    else
                    {
                        <div style="display:none"></div>
                    }
                }
            </MudExDockLayout>
        </MudHidden>

        <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
            <div class="d-flex flex-column" style="height:100%">
                <MudSelect T="string" Value="@activeCodeFile?.Path" ValueChanged="@OpenFileMobile" Dense="true" Class="px-2">
                    @foreach (var name in CodeFileNames)
                    {
                        <MudSelectItem Value="@name">@name</MudSelectItem>
                    }
                </MudSelect>
                <div style="flex:1; min-height:150px;">
                    <CodeEditor Id="@MobileEditorId" Theme="@EditorTheme" Code="@activeCodeFile?.Content" CodeFileType="@(activeCodeFile?.Type ?? CodeFileType.Razor)" />
                </div>
                <iframe style="flex:1; border:none;" id="user-page-window" data-base-src="/user-page" src="/user-page"></iframe>
            </div>
        </MudHidden>
    </div>

    <MudAppBar Bottom="true" Fixed="false" Color="@GetBottomAppBarColor()" Elevation="0" Class="try-errorlist repl-navbar">
        <div class="try-errorlist-button d-flex align-center" @onclick="@ShowErrorsPanel">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" />
            <MudText>@ErrorsCount</MudText>
            <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" />
            <MudText>@WarningsCount</MudText>
        </div>
        <MudSpacer />
        <MudButton DropShadow="false" Ripple="false" OnClick="@ReloadIframe">Reload</MudButton>
        <MudDivider Vertical="true" Class="mr-1" />
        @foreach (var package in _installedPackages.Take(_maxPackagesInStatusBar))
        {
            <MudText Typo="Typo.body2" Class="mr-3 try-mudblazor-version">
                <a href="@package.ProjectUrl" target="_blank">@TrimmedPackageText(package)</a>
            </MudText>
        }
        @if (_installedPackages.Length > _maxPackagesInStatusBar)
        {
            <MudMenu Style="align-self: end;" MaxHeight="400" Dense="true">
                <ActivatorContent>
                    <MudIconButton Style="transform: scale(.8);" Class="rounded-0 py-0 px-2" Icon="@Icons.Material.Filled.MoreHoriz" OnClick="@context.ToggleAsync"></MudIconButton>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var package in _installedPackages)
                    {
                        <MudText Typo="Typo.body2" Class="py-1 px-1 mb-1">
                            <a href="@package.ProjectUrl" target="_blank">@TrimmedPackageText(package, 70)</a>
                        </MudText>
                    }
                </ChildContent>
            </MudMenu>
        }
        <MudTooltip Text="Manage Nuget packages" Placement="Placement.Left">
            <MudIconButton Style="transform: scale(.8);" Icon="@MudExIcons.Custom.Brands.Nuget" Class="rounded-0 py-0 px-0" OnClick="@(() => EditPackageReferences(true))"></MudIconButton>
        </MudTooltip>
    </MudAppBar>
</div>
@code {
    int _maxPackagesInStatusBar = 4;
    public Color GetBottomAppBarColor() => ErrorsCount != 0 ? Color.Error : WarningsCount != 0 ? Color.Warning : Color.Inherit;

    private string TrimmedPackageText(NugetPackage package, int maxChars = 35)
    {
        var text = $"{package.Id} {package.Version}";

        if (text.Length > maxChars)
        {
            return text.Substring(0, maxChars - 3) + "...";
        }

        return text;
    }
}
