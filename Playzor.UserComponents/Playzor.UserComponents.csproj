<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="..\build\Playzor.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- assembly identity is fixed: the preview swaps the compiled snippet in under exactly this
         name, and every saved snippet declares "namespace Try.UserComponents" in its .cs files -->
    <AssemblyName>Try.UserComponents</AssemblyName>
    <RootNamespace>Try.UserComponents</RootNamespace>

    <PackageId>Playzor.UserComponents</PackageId>
    <Title>Playzor User Components</Title>
    <Description>Placeholder assembly for the component a Playzor preview runs. The host renders its __Main component and the editor swaps the assembly for the freshly compiled snippet on every run.</Description>
    <PackageTags>Blazor;Playzor;Playground;Preview;WebAssembly</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
