@page "/document-editor"
@inherits BasePage

@using MainSample.WebAssembly.Examples.DocumentEditor
@using MainSample.WebAssembly.Examples.Spreadsheet

@attribute [DemoNew(Name = "Overview", Group = "Office Editors/Document", Order = 0, Icon = Icons.Material.Outlined.Description, ForComponentTypes = new[] { typeof(MudExDocumentEditor) }, Documentation = "MudExDocumentEditor - a Word-like editor with ribbon, styles, lists, tables, find and replace, undo and docx, doc, rtf, odt and markdown files.")]

<DemoHero PageType="@GetType()" Title="MudEx Document Editor" Description="Write and format documents like in Word: type, style paragraphs, build lists and tables, find and replace, undo and save as docx. The editor fills its container, so give the host element a height.">
    <div class="mx-tiles">
        @foreach (var (title, text) in _tiles)
        {
            <div class="mx-tile">
                <div class="mx-tile-title">@L[title]</div>
                <div class="mx-tile-text">@L[text]</div>
            </div>
        }
    </div>
</DemoHero>

<MudExDemoPage>

    <MudExDemoBox Title="1. A document built in code"
                  NavTitle="Document built in code"
                  FeaturesPlacement="DemoFeaturesPlacement.Below"
                  FeaturesTitle="Used in this document"
                  Features="@(new[]
                              {
                                  "Title and heading styles",
                                  "Bold, italic, underlined, colored and highlighted text",
                                  "Bulleted and numbered lists",
                                  "A table",
                                  "@bind-TextDocument - the document follows every edit"
                              })">
        <DemoContent>
            <SpreadsheetLazyDemo>
                <DocumentOverviewExample />
            </SpreadsheetLazyDemo>
        </DemoContent>
    </MudExDemoBox>

    <MudExDemoBox Title="2. Read-only viewer"
                  NavTitle="Read-only viewer"
                  FeaturesPlacement="DemoFeaturesPlacement.Below"
                  FeaturesTitle="Highlights"
                  Features="@(new[]
                              {
                                  "ReadOnly - no editing",
                                  "Zoom, find and the status bar still work"
                              })">
        <DemoContent>
            <SpreadsheetLazyDemo>
                <DocumentViewerExample />
            </SpreadsheetLazyDemo>
        </DemoContent>
    </MudExDemoBox>

    <MudExDemoBox Title="3. Tables and pictures"
                  NavTitle="Tables and pictures"
                  FeaturesPlacement="DemoFeaturesPlacement.Below"
                  FeaturesTitle="Highlights"
                  Features="@(new[]
                              {
                                  "Table Design and Layout tabs for the table under the caret",
                                  "Picture Format tab, resize and context menu for pictures",
                                  "Mini toolbar next to the selection"
                              })">
        <DemoContent>
            <SpreadsheetLazyDemo>
                <DocumentTablesExample />
            </SpreadsheetLazyDemo>
        </DemoContent>
    </MudExDemoBox>

    <MudExDemoBox Title="4. Pages view and print"
                  NavTitle="Pages view and print"
                  FeaturesPlacement="DemoFeaturesPlacement.Below"
                  FeaturesTitle="Highlights"
                  Features="@(new[]
                              {
                                  "DocumentView Pages with page breaks and Page x of y",
                                  "Layout tab and headers and footers",
                                  "File > Print"
                              })">
        <DemoContent>
            <SpreadsheetLazyDemo>
                <DocumentPagesExample />
            </SpreadsheetLazyDemo>
        </DemoContent>
    </MudExDemoBox>

</MudExDemoPage>

<DemoNavigation CurrentPage="@this" />

@code {
    private static readonly (string Title, string Text)[] _tiles =
    [
        ("Ribbon", "Home, Insert, Layout and View tabs with the usual Word groups."),
        ("Styles", "Paragraph and character styles, fonts, sizes, colors and highlights."),
        ("Lists and tables", "Bulleted and numbered lists, tables with merged cells."),
        ("Find and replace", "A find panel with match case and replace all."),
        ("Clipboard", "Cut, copy and paste text, HTML and pictures."),
        ("Undo and redo", "Every action is one undo step."),
        ("Many formats", "docx, doc, rtf and odt in; docx, rtf, html, markdown and text out."),
        ("Large documents", "Only the visible part is rendered.")
    ];
}
