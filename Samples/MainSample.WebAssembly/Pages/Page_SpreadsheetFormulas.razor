@page "/spreadsheet-formulas"
@inherits BasePage

@using MainSample.WebAssembly.Examples.Spreadsheet

@attribute [DemoNew(Name = "Formulas", Group = "Office Editors/Spreadsheet", Order = 10, Icon = Icons.Material.Outlined.Functions, ForComponentTypes = new[] { typeof(MudExSpreadsheetEditor) }, Documentation = "Formulas, functions and dynamic array spills in MudExSpreadsheetEditor.")]

<DemoHero PageType="@GetType()" Title="MudEx Spreadsheet - Formulas" Description="Formulas use English function names. Both , and ; are accepted as argument separators, and the file stores the Excel form with a comma. Only affected cells are recalculated.">
</DemoHero>

<MudExDemoPage>

    <MudExDemoBox Title="1. Budget with formulas"
                  NavTitle="Budget with formulas"
                  FeaturesPlacement="DemoFeaturesPlacement.Below"
                  FeaturesTitle="Used in this workbook"
                  Features="@(new[]
                              {
                                  "SUM and AVERAGE over rows and columns",
                                  "IF for the status column",
                                  "XLOOKUP for the lookup cell B11",
                                  "FILTER spills a list starting at A14",
                                  "Insert and Formulas tabs list all functions with signature and description"
                              })">
        <DemoContent>
            <SpreadsheetFormulasExample />
        </DemoContent>
    </MudExDemoBox>

</MudExDemoPage>

<DemoNavigation CurrentPage="@this" />
