@page "/tree-view-advanced"
@inherits BasePage

@using MainSample.WebAssembly.Examples.Tree

@attribute [Demo(Name = "Advanced Examples", Documentation = "This demo shows advanced scenarios of MudExTreeView with larger data and custom behavior.", Order = 10, Group = "TreeView", ForComponentTypes = new[] { typeof(MudExTreeView<>) })]


<DemoHero PageType="@GetType()" Title="MudEx Tree View - Advanced Examples" Description="This page demonstrates advanced use cases and practical scenarios for the MudExTreeView component, including multi-selection, search/filtering, lazy loading, and custom icons.">
    <div class="mx-tiles">
        <div class="mx-tile">
            <div class="mx-tile-title">@L["Multi-selection"]</div>
            <div class="mx-tile-text">@L["Enable users to select multiple nodes with checkboxes for batch operations."]</div>
        </div>
        <div class="mx-tile">
            <div class="mx-tile-title">@L["Search & Filter"]</div>
            <div class="mx-tile-text">@L["Filter tree nodes dynamically based on search criteria."]</div>
        </div>
        <div class="mx-tile">
            <div class="mx-tile-title">@L["Lazy Loading"]</div>
            <div class="mx-tile-text">@L["Load child nodes asynchronously on demand for performance."]</div>
        </div>
        <div class="mx-tile">
            <div class="mx-tile-title">@L["Custom Icons"]</div>
            <div class="mx-tile-text">@L["Display contextual icons based on node type or content."]</div>
        </div>
    </div>
</DemoHero>

<MudDivider Class="mb-6" />

<MudExDemoPage>

    <!-- Demo 1: Multi-selection with checkboxes -->
    <MudExDemoBox Title="Multi-selection with checkboxes"
                  NavTitle="Multi-selection"
                  FeaturesTitle="Configuration"
                  Features="@(new[]
                            {
                                "MultiSelection = true – Enable multi-select mode",
                                "@bind-SelectedNodes – Track selected nodes collection",
                                "AllowSelectionOfNonEmptyNodes – Allow parent node selection",
                                "Checkbox-based selection UI"
                            })">

        <DemoContent>
            <MudText Typo="Typo.body2" Class="mb-4">
                @L["Enable multi-selection to allow users to select multiple tree nodes. This is useful for batch operations, bulk actions, or when users need to work with multiple items simultaneously."]
            </MudText>
            <TreeViewCheckboxExample/>
        </DemoContent>
    </MudExDemoBox>


    <!-- Demo 3: Async/Lazy loading -->
    <MudExDemoBox Title="Async loading and lazy loading"
                  NavTitle="Lazy Loading"
                  FeaturesTitle="Benefits"
                  Features="@(new[]
                            {
                                "Load children on demand",
                                "Improved initial load performance",
                                "Support for remote data sources",
                                "Loading indicators for async operations"
                            })">

        <DemoContent>
            <MudText Typo="Typo.body2" Class="mb-4">
                @L["Use lazy loading to defer loading of child nodes until they are needed. This significantly improves performance for large hierarchies and enables integration with APIs and databases."]
            </MudText>
            <TreeViewLazyLoadExample/>
        </DemoContent>
    </MudExDemoBox>

    <!-- Demo: drag and drop -->
    <MudExDemoBox Title="Drag and drop"
                  NavTitle="Drag & Drop"
                  FeaturesTitle="Parameters"
                  Features="@(new[]
                            {
                                "AllowDrag / AllowDragFunc - which nodes can be picked up",
                                "AllowDrop / CanDropFunc - which nodes accept a drop",
                                "DragScope - two trees exchange nodes only when it matches",
                                "OnNodeDropped - MudExTreeViewDropInfo, including the source tree view",
                                "OnExternalFilesDropped - files dragged in from the operating system"
                            })">

        <DemoContent>
            <MudText Typo="Typo.body2" Class="mb-4">
                @L["Drag and drop works in every view mode: the handlers sit on the wrapper around each node's content, so a mode does not opt in. Moving the node is the consumer's job - the tree view reports the drop and never touches the structure itself."]
            </MudText>
            <TreeViewDragDropExample/>
        </DemoContent>
    </MudExDemoBox>

    <!-- Demo 4: File browser with icons -->
    <MudExDemoBox Title="File browser with custom icons"
                  NavTitle="Custom Icons"
                  FeaturesTitle="Use Cases"
                  Features="@(new[]
                            {
                                "ItemContentTemplate for custom rendering",
                                "File type detection",
                                "Contextual icons (folders, files, documents)",
                                "Visual hierarchy with icons"
                            })">

        <DemoContent>
            <MudText Typo="Typo.body2" Class="mb-4">
                @L["Create a file browser-style interface with custom icons for different file types. This provides better visual context and helps users quickly identify content types in the tree."]
            </MudText>
            <TreeViewIconExample/>
        </DemoContent>
    </MudExDemoBox>

</MudExDemoPage>


<DemoNavigation CurrentPage="@this" />

