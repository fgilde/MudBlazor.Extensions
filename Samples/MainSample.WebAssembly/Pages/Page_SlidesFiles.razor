@page "/slides-files"
@inherits BasePage

@using MainSample.WebAssembly.Examples.Slides

@attribute [DemoNew(Name = "Files", Group = "Slide Editor", Order = 20, Icon = Icons.Material.Outlined.FolderOpen, ForComponentTypes = new[] { typeof(MudExSlideEditor) }, Documentation = "Open and save pptx files locally or save to a server with SaveRequested.")]

<MudPaper Class="pa-6 mb-6">
    <MudText Typo="Typo.h4" GutterBottom="true">
        @L["MudEx Slide Editor – Files"]
    </MudText>
    <MudText Typo="Typo.body1">
        @L["The File menu opens and creates presentations and saves them locally. Content the editor does not model is written back unchanged."]
    </MudText>
</MudPaper>

<MudExDemoPage>

    <MudExDemoBox Title="1. Open and save locally"
                  NavTitle="Open and save locally"
                  FeaturesPlacement="DemoFeaturesPlacement.Below"
                  FeaturesTitle="Highlights"
                  Features="@(new[]
                              {
                                  "sample.pptx is loaded through Presentation.Load",
                                  "File menu: Open, New, Save, Save As",
                                  "AllowOpen, AllowNew and AllowLocalSave control the File menu",
                                  "A failed download shows an alert instead of the editor"
                              })">
        <DemoContent>
            <SlidesFilesExample />
        </DemoContent>
    </MudExDemoBox>

    <MudExDemoBox Title="2. Save to a server (simulated)"
                  NavTitle="Save to a server"
                  FeaturesPlacement="DemoFeaturesPlacement.Below"
                  FeaturesTitle="Parameters and events"
                  Features="@(new[]
                              {
                                  "SaveRequested – receives the exported file as MudExFileSaveRequest",
                                  "Handled = true – tells the editor that your code stored the file",
                                  "The content stream is only valid during the handler, so copy it"
                              })">
        <DemoContent>
            <MudText Typo="Typo.body2" Class="mb-4">
                @L["Change something and press Ctrl+S. The handler reports the file name and size with a snackbar."]
            </MudText>
            <SlidesServerSaveExample />
        </DemoContent>
    </MudExDemoBox>

</MudExDemoPage>

<DemoNavigation CurrentPage="@this" />
