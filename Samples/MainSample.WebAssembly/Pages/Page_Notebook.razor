@page "/notebook"
@inherits BasePage

@using MainSample.WebAssembly.Examples.Notebook
@using MainSample.WebAssembly.Examples.Spreadsheet

@attribute [DemoNew(Name = "Overview", Group = "Notebook Editor", Order = 0, Icon = Icons.Material.Outlined.Book, ForComponentTypes = new[] { typeof(MudExNotebookEditor) }, Documentation = "MudExNotebookEditor – a OneNote-like notebook with sections, pages, free text, handwriting, shapes, tables and pictures.")]

<MudPaper Class="pa-6 mb-6">
    <MudText Typo="Typo.h4" GutterBottom="true">
        @L["MudEx Notebook Editor"]
    </MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        @L["Take notes on free-form pages: type anywhere, draw with a pen, add shapes, tables and pictures. Notebooks are saved as mxnb files. The editor fills its container, so give the host element a height."]
    </MudText>
    <MudGrid>
        @foreach (var (title, text) in _tiles)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Outlined="true" Class="pa-3 fill-height">
                    <MudText Typo="Typo.subtitle2">@title</MudText>
                    <MudText Typo="Typo.body2">@text</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</MudPaper>

<MudExDemoPage>

    <MudExDemoBox Title="1. A notebook built in code"
                  NavTitle="Notebook built in code"
                  FeaturesPlacement="DemoFeaturesPlacement.Below"
                  FeaturesTitle="Used in this notebook"
                  Features="@(new[]
                              {
                                  "Two sections with five pages, two of them sub pages",
                                  "Headings, rich text, bullet, numbered and to-do lists",
                                  "A table, a picture and shapes",
                                  "Pen and highlighter strokes, even a single dot",
                                  "@bind-Notebook – the notebook follows every edit"
                              })">
        <DemoContent>
            <SpreadsheetLazyDemo>
                <NotebookOverviewExample />
            </SpreadsheetLazyDemo>
        </DemoContent>
    </MudExDemoBox>

    <MudExDemoBox Title="2. Read-only viewer"
                  NavTitle="Read-only viewer"
                  FeaturesPlacement="DemoFeaturesPlacement.Below"
                  FeaturesTitle="Highlights"
                  Features="@(new[]
                              {
                                  "ReadOnly – no editing, no page management",
                                  "Sections, pages and zoom still work"
                              })">
        <DemoContent>
            <SpreadsheetLazyDemo>
                <NotebookViewerExample />
            </SpreadsheetLazyDemo>
        </DemoContent>
    </MudExDemoBox>

</MudExDemoPage>

<DemoNavigation CurrentPage="@this" />

@code {
    private static readonly (string Title, string Text)[] _tiles =
    [
        ("Free-form pages", "Click anywhere to place text, move and resize blocks."),
        ("Rich text", "Headings, fonts, colors, links and bullet, numbered and to-do lists."),
        ("Handwriting", "Pen, highlighter, eraser and lasso with pressure-aware strokes."),
        ("Shapes and tables", "Lines, arrows and basic shapes, tables with rows and columns."),
        ("Pictures", "Paste or insert pictures and describe them with alt text."),
        ("Sections and pages", "Colored section tabs and a page list with sub pages."),
        ("Lossless mxnb", "Pages you did not touch are saved byte for byte."),
        ("Search and print", "Find text across the notebook and print a page.")
    ];
}
