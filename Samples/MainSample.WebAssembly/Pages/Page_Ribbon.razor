@page "/ribbon"
@inherits BasePage

@using MainSample.WebAssembly.Examples.Ribbon

@attribute [DemoNew(Name = "Overview", Documentation = "MudExRibbon is an Office style command ribbon. This demo builds a ribbon with tabs, groups and commands.", Order = 0, Group = "Office Editors/Ribbon", Icon = Icons.Material.Outlined.ViewDay, ForComponentTypes = new[] { typeof(MudExRibbon) })]

<DemoHero PageType="@GetType()" Title="MudEx Ribbon" Description="MudExRibbon renders tabs, groups and commands in four presentations from one declaration: Classic, Simplified, Menu and Toolbar. It adapts to the available width, offers a file menu, a quick access toolbar, command search and keyboard access.">
    <div class="mx-tiles">
        <div class="mx-tile">
            <div class="mx-tile-title">@L["Four modes, one definition"]</div>
            <div class="mx-tile-text">@L["Classic, Simplified, Menu and Toolbar all render the same tabs, groups and items."]</div>
        </div>
        <div class="mx-tile">
            <div class="mx-tile-title">@L["Rich items"]</div>
            <div class="mx-tile-text">@L["Buttons, toggles, split and menu buttons, galleries, number boxes, selects, color pickers and custom content."]</div>
        </div>
        <div class="mx-tile">
            <div class="mx-tile-title">@L["Adaptive and accessible"]</div>
            <div class="mx-tile-text">@L["Groups collapse by priority when space runs out. Key tips, keyboard navigation and ARIA roles are built in."]</div>
        </div>
    </div>
</DemoHero>

<MudAlert Severity="Severity.Info" Class="mb-6">
    @L["Press Alt while the ribbon has focus to show the key tips, then type the shown letters. Use the search box to run any command by name and pin commands to the quick access toolbar. Every click is reported below the ribbon."]
</MudAlert>

<MudDivider Class="mb-6" />

<MudExDemoPage>

    <MudExDemoBox Title="1. Word like ribbon"
                  NavTitle="Word like ribbon"
                  FeaturesTitle="What is in it"
                  Features="@(new[]
                              {
                                  "Tabs Home, Insert and View with KeyTips H, N and W",
                                  "Split button Paste with a nested menu and Ctrl+V shortcut",
                                  "Font Select, size NumberBox, bold/italic/underline toggles and color pickers",
                                  "Gallery Styles with two rows",
                                  "File menu backstage, quick access toolbar and command search"
                              })">
        <DemoContent>
            <MudText Typo="Typo.body2" Class="mb-4">
                @L["Change the font, size, colors and style and watch the sample text below the ribbon follow. Open the File menu, pin commands to the quick access toolbar or search for a command."]
            </MudText>
            <RibbonWordLikeExample ShowSnackbar="true" />
        </DemoContent>
    </MudExDemoBox>

    <MudExDemoBox Title="2. Adaptive shrinking"
                  NavTitle="Adaptive shrinking"
                  FeaturesTitle="Highlights"
                  Features="@(new[]
                              {
                                  "CollapsePriority decides which group collapses first",
                                  "Collapsed groups turn into a dropdown button with the group icon",
                                  "All commands stay reachable at the smallest width"
                              })">
        <DemoContent>
            <MudText Typo="Typo.body2" Class="mb-4">
                @L["Drag the slider to resize the container instead of the browser window. Groups collapse one by one and expand again when there is room."]
            </MudText>
            <RibbonAdaptiveExample />
        </DemoContent>
    </MudExDemoBox>

</MudExDemoPage>

<DemoNavigation CurrentPage="@this" />
