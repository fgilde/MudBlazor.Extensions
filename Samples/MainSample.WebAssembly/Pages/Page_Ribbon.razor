@page "/ribbon"
@inherits BasePage

@using MainSample.WebAssembly.Examples.Ribbon

@attribute [DemoNew(Name = "Overview", Documentation = "MudEx Ribbon – Office style command ribbon", Order = 0, Group = "Ribbon", Icon = Icons.Material.Outlined.ViewDay, ForComponentTypes = new[] { typeof(MudExRibbon) })]

<MudPaper Class="pa-6 mb-6">
    <MudText Typo="Typo.h4" GutterBottom="true">
        @L["MudEx Ribbon – Office style command ribbon"]
    </MudText>
    <MudText Typo="Typo.body1">
        @L["MudExRibbon renders tabs, groups and commands in four presentations from one declaration: Classic, Simplified, Menu and Toolbar. It adapts to the available width, offers a file menu, a quick access toolbar, command search and keyboard access."]
    </MudText>
    <MudAlert Severity="Severity.Info" Class="mt-4">
        @L["Press Alt while the ribbon has focus to show the key tips, then type the shown letters. Use the search box to run any command by name and pin commands to the quick access toolbar. Every click is reported below the ribbon."]
    </MudAlert>
</MudPaper>

<MudGrid Class="mb-6">
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 h-100">
            <MudText Typo="Typo.subtitle1">@L["Four modes, one definition"]</MudText>
            <MudText Typo="Typo.body2">@L["Classic, Simplified, Menu and Toolbar all render the same tabs, groups and items."]</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 h-100">
            <MudText Typo="Typo.subtitle1">@L["Rich items"]</MudText>
            <MudText Typo="Typo.body2">@L["Buttons, toggles, split and menu buttons, galleries, number boxes, selects, color pickers and custom content."]</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 h-100">
            <MudText Typo="Typo.subtitle1">@L["Adaptive and accessible"]</MudText>
            <MudText Typo="Typo.body2">@L["Groups collapse by priority when space runs out. Key tips, keyboard navigation and ARIA roles are built in."]</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudDivider Class="mb-6" />

<MudExDemoPage>

    <MudExDemoBox Title="1. Word like ribbon"
                  NavTitle="Word like ribbon"
                  FeaturesTitle="What is in it"
                  Features="@(new[]
                              {
                                  "Tabs Home, Insert and View with KeyTips H, N and W",
                                  "Split button Paste with a nested menu and Ctrl+V shortcut",
                                  "Font Select, size NumberBox, bold/italic/underline toggles and color pickers",
                                  "Gallery Styles with two rows",
                                  "File menu backstage, quick access toolbar and command search"
                              })">
        <DemoContent>
            <MudText Typo="Typo.body2" Class="mb-4">
                @L["Change the font, size, colors and style and watch the sample text below the ribbon follow. Open the File menu, pin commands to the quick access toolbar or search for a command."]
            </MudText>
            <RibbonWordLikeExample ShowSnackbar="true" />
        </DemoContent>
    </MudExDemoBox>

    <MudExDemoBox Title="2. Adaptive shrinking"
                  NavTitle="Adaptive shrinking"
                  FeaturesTitle="Highlights"
                  Features="@(new[]
                              {
                                  "CollapsePriority decides which group collapses first",
                                  "Collapsed groups turn into a dropdown button with the group icon",
                                  "All commands stay reachable at the smallest width"
                              })">
        <DemoContent>
            <MudText Typo="Typo.body2" Class="mb-4">
                @L["Drag the slider to resize the container instead of the browser window. Groups collapse one by one and expand again when there is room."]
            </MudText>
            <RibbonAdaptiveExample />
        </DemoContent>
    </MudExDemoBox>

</MudExDemoPage>

<DemoNavigation CurrentPage="@this" />
