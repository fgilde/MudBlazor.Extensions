@page "/gravatar"
@inherits BasePage
@attribute [Demo(IsPlaygroundDemo = true, Name = "MudExGravatar", Icon = Icons.Material.Outlined.SupervisorAccount, Documentation = "MudExGravatar is a MudAvatar that loads the profile image of an email address from Gravatar. This demo shows it with a property editor.", ForComponentType = typeof(MudExGravatar))]

<DemoComponent PageType="@GetType()" >
    <SplitContainer>
        <Left>
            <MudExGravatar @ref="component" Email="jitewaboh@lagify.com"></MudExGravatar>
        </Left>
        <Right>
            <ComponentPropertyGrid Value="@component"></ComponentPropertyGrid>
        </Right>
    </SplitContainer>
</DemoComponent>


@code {
    MudExGravatar component;
}