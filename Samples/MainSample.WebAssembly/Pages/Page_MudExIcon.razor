@page "/mud-ex-icon"
@inherits BasePage
@using MudBlazor.Extensions.Components.ObjectEdit.Options

@attribute [Demo(IsPlaygroundDemo = true, Name = "MudExIcon", Icon = Icons.Material.Outlined.Image, Documentation = "MudExIcon is a MudIcon that lets you set all colors of the icon. This demo shows its options.", ForComponentType = typeof(MudExIcon))]

<DemoComponent PageType="@GetType()" >
    <SplitContainer>
        <Left>
            <MudExIcon @ref="component" Icon="@Icons.Material.Filled.Image" />
        </Left>
        <Right>
            <ComponentPropertyGrid MetaConfiguration="@Configure()" Value="@component"></ComponentPropertyGrid>
        </Right>
    </SplitContainer>
</DemoComponent>


@code {
    MudExIcon component;
    private Action<ObjectEditMeta<MudExIcon>> Configure()
    {
        return meta =>
        {
            meta.Property(m => m.Localizer).Ignore();            
            meta.IgnoreAllReadOnlyFields();
        };
    }

}