<ApiLink Types="@_types"></ApiLink>

<MudGrid Class="mt-6 mb-8">
    <MudItem xs="12" md="@(ShowNav ? 9 : 12)">
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </MudItem>

    @if (ShowNav)
    {
        <MudItem xs="0" md="3" Class="d-none d-md-block">
            @if (_sections.Count > 0)
            {
                <MudExContentsNav @ref="contentsNav" Items="_sections.OrderBy(s => s.Order).ToList()" />
            }
        </MudItem>
    }
</MudGrid>
