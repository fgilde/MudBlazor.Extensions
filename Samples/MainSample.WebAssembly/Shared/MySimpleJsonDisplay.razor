@using System.Text.Json
@using Microsoft.Extensions.Localization
@using MudBlazor.Extensions.Options
@using MudBlazor.Extensions.Core
@using MudBlazor.Extensions.Helper
@using MudBlazor.Extensions.Services
@using Nextended.Core.Extensions
@inject IDialogService dialogService
@inject MudExFileService fileService
@inject HttpClient http
@implements IMudExFileDisplay
@inject IStringLocalizer<MySimpleJsonDisplay> L

@* Reference implementation of a custom viewer. MudExFileDisplay finds every class that implements
   IMudExFileDisplay in the app assembly, so no registration code is needed. *@

<div class="d-flex align-center gap-2 mb-1">
    <MudIcon Icon="@Icons.Material.Outlined.DataObject" Size="Size.Small" />
    <MudText Typo="Typo.subtitle2">@Name</MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["{0} lines", _lineCount]</MudText>
    <MudSpacer />
    <MudLink Typo="Typo.caption" OnClick="@ShowCode">@L["Show the source of this viewer"]</MudLink>
</div>

<MudTextField ReadOnly="true" Value="@_text" Variant="Variant.Outlined" T="string" Lines="16" />

@code {
    private string _text;
    private int _lineCount;
    private object _loadedSource;

    // Shown in the "Render with ..." menu when the user can choose between several viewers for one file
    public string Name => "Simple JSON display";

    // Wins against viewers with the same claim (default is 0), so this one is used first for json
    public int RenderPriority => 10;

    // Be as exact as possible here, otherwise the viewer is offered for files it cannot show
    public Task<bool> CanHandleFileAsync(IMudExFileDisplayInfos fileDisplayInfos, IMudExFileService fileService)
        => Task.FromResult(fileDisplayInfos.ContentType == "application/json"
                           || (fileDisplayInfos.ContentType == "text/plain" && fileDisplayInfos.FileName.EndsWith(".json", StringComparison.OrdinalIgnoreCase)));

    // Must be a [Parameter]: MudExFileDisplay sets it when it renders this component
    [Parameter]
    public IMudExFileDisplayInfos FileDisplayInfos { get; set; }

    // Extra rows for the info dialog and the metadata view
    public Task<IDictionary<string, object>> FileMetaInformationAsync(IMudExFileDisplayInfos fileDisplayInfos)
        => Task.FromResult<IDictionary<string, object>>(new Dictionary<string, object> { { "Lines", _lineCount } });

    protected override async Task OnParametersSetAsync()
    {
        // The same component instance is reused for the next file of this kind, so reload when the source changed
        if (!FileDisplayInfos.SourceChanged(ref _loadedSource))
            return;

        var raw = await fileService.ReadAsStringFromFileDisplayInfosAsync(FileDisplayInfos);
        _text = Format(raw);
        _lineCount = _text.GetLines().Count();
        await FileDisplayInfos.NotifyMetaChangedAsync(); // the line count exists now
    }

    private static string Format(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return json; // not valid json, show as is
        }
    }

    protected override void OnInitialized()
    {
        if (MainLayout.Instance != null)
            MainLayout.Instance.LanguageChanged += (_, _) => InvokeAsync(StateHasChanged);
    }

    private async Task ShowCode()
    {
        var file = GH.Path($"Shared/{GetType().Name}.razor");
        string code = await http.GetStringAsync(file);
        await dialogService.ShowComponentInDialogAsync<DemoMarkdown>(L["Code for this component"], L["Like this you can implement your own components that is responsible for a File"],
            md => { md.Value = MudExCodeView.CodeAsMarkup(code); },
            dialog =>
            {
                dialog.Icon = Icons.Material.Filled.Code;
                dialog.Buttons = MudExDialogResultAction.Ok();
            }, new DialogOptionsEx
            {
                DialogAppearance = MudExAppearance.FromCss(MudExCss.Classes.Dialog.Glass),
                DragMode = MudDialogDragMode.Simple,
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseButton = true,
                Resizeable = true,
            });
    }
}
