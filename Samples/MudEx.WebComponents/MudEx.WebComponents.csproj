<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <Import Project="..\..\MudBlazor.Extensions\version.generated.props" Condition="Exists('..\..\MudBlazor.Extensions\version.generated.props')" />
  <Import Project="..\..\Shared.props" Condition="Exists('..\..\Shared.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Debug publishes are for local testing, trimming would only slow them down. -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Release'">false</PublishTrimmed>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <!-- The custom elements are registered by reflection over the whole MudBlazor.Extensions assembly,
       so the trimmer must keep every component type and every [Parameter] of it. Rooting the assemblies
       does that while the framework itself still gets trimmed - which is where the megabytes are. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="MudBlazor.Extensions" />
    <TrimmerRootAssembly Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.CustomElements" />
    <PackageReference Condition="'$(Configuration)' == 'Release'" Include="MudBlazor.Extensions" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <ProjectReference Include="..\..\MudBlazor.Extensions\MudBlazor.Extensions.csproj" />
  </ItemGroup>

  <!-- The published bundle is served from the main sample app at /wc/, so publishing this project
       is all it takes to have it available locally and on www.mudex.org. -->
  <PropertyGroup>
    <WebComponentsTargetDir>$(MSBuildThisFileDirectory)..\MainSample.WebAssembly\wwwroot\wc\</WebComponentsTargetDir>
  </PropertyGroup>

  <!-- publish does not clean its output, so fingerprinted assemblies of every previous run pile up
       (50 MB of dead weight after a day of iterating, and the wrong one can end up being served). -->
  <Target Name="CleanPublishDirBeforePublish" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)" ContinueOnError="true" />
  </Target>

  <!-- package.json so the very same output can be published to npm and consumed via jsDelivr/unpkg -->
  <Target Name="WriteNpmPackageJson" AfterTargets="Publish">
    <PropertyGroup>
      <NpmPackageVersion Condition="'$(MudEx_PackageVersion)' != ''">$(MudEx_PackageVersion)</NpmPackageVersion>
      <NpmPackageVersion Condition="'$(NpmPackageVersion)' == ''">0.0.0</NpmPackageVersion>
      <NpmPackageJson>$(PublishDir)wwwroot\package.json</NpmPackageJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(NpmPackageJson)" Overwrite="true" Lines="{&quot;name&quot;:&quot;mudex-webcomponents&quot;,&quot;version&quot;:&quot;$(NpmPackageVersion)&quot;,&quot;description&quot;:&quot;MudBlazor.Extensions components as browser custom elements&quot;,&quot;main&quot;:&quot;mudex.js&quot;,&quot;homepage&quot;:&quot;https://www.mudex.org&quot;,&quot;license&quot;:&quot;MIT&quot;,&quot;repository&quot;:{&quot;type&quot;:&quot;git&quot;,&quot;url&quot;:&quot;git+https://github.com/fgilde/MudBlazor.Extensions.git&quot;},&quot;keywords&quot;:[&quot;mudblazor&quot;,&quot;blazor&quot;,&quot;web-components&quot;,&quot;custom-elements&quot;,&quot;file-viewer&quot;]}" />
    <!-- the cdn only needs the loader and the assets it pulls. Pre-compressed copies, the iis
         config and the demo file are dead weight in a npm package. -->
    <WriteLinesToFile File="$(PublishDir)wwwroot\.npmignore" Overwrite="true" Lines="*.br;*.gz;web.config;sample-data/;index.html" />
  </Target>

  <Target Name="CopyWebComponentsToMainSample" AfterTargets="Publish">
    <ItemGroup>
      <!-- IIS compresses dynamically (see wwwroot\web.config), the pre-compressed copies are dead
           weight and confuse the static web asset pipeline of the app hosting this folder.
           Source maps are dev artifacts - they alone are ~15 MB of the bundle. -->
      <PublishedWebComponentFiles Include="$(PublishDir)wwwroot\**\*" Exclude="$(PublishDir)wwwroot\**\*.gz;$(PublishDir)wwwroot\**\*.br;$(PublishDir)wwwroot\**\*.map" />
    </ItemGroup>
    <RemoveDir Directories="$(WebComponentsTargetDir)" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="@(PublishedWebComponentFiles)"
          DestinationFiles="@(PublishedWebComponentFiles->'$(WebComponentsTargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <!-- A failed RemoveDir (the consuming app is running and holds the files) leaves the previous
         fingerprinted assemblies next to the new ones, and the wrong one ends up being served.
         That is worth stopping for - unlike the delete itself, which may just need a retry. -->
    <ItemGroup>
      <_StaleLibraryCopies Include="$(WebComponentsTargetDir)_framework\MudBlazor.Extensions.*.wasm" />
    </ItemGroup>
    <Error Condition="@(_StaleLibraryCopies->Count()) &gt; 1"
           Text="$(WebComponentsTargetDir) holds @(_StaleLibraryCopies->Count()) copies of MudBlazor.Extensions. The old ones could not be deleted - stop the app that serves this folder and publish again." />
    <Message Importance="High" Text="Web components copied to $(WebComponentsTargetDir)" />
  </Target>

</Project>
