@implements IDisposable

<div class="playzor-console d-flex flex-column" style="height:100%; min-height:0;">
    <div class="d-flex align-center flex-wrap px-2 py-1" style="gap:4px;">
        <MudTextField T="string" Value="@_filter" ValueChanged="@(v => { _filter = v; })" Immediate="true" Clearable="true"
                      Placeholder="@L["Filter..."]" Variant="Variant.Text" Margin="Margin.Dense" Class="mt-0" Style="max-width:180px;" />
        <MudChipSet T="string" SelectedValues="@_levels" SelectedValuesChanged="@(v => _levels = v?.ToHashSet() ?? new())"
                    SelectionMode="SelectionMode.MultiSelection" Size="Size.Small" Variant="Variant.Text" CheckMark="true">
            <MudChip T="string" Value="@("error")" Color="Color.Error">@L["Errors"]</MudChip>
            <MudChip T="string" Value="@("warn")" Color="Color.Warning">@L["Warnings"]</MudChip>
            <MudChip T="string" Value="@("log")" Color="Color.Default">@L["Logs"]</MudChip>
        </MudChipSet>
        <MudSpacer />
        <MudTooltip Text="@L["Follow output"]">
            <MudToggleIconButton Toggled="@_follow" ToggledChanged="@(v => _follow = v)" Size="Size.Small"
                                 Icon="@Icons.Material.Outlined.VerticalAlignBottom" ToggledIcon="@Icons.Material.Filled.VerticalAlignBottom"
                                 ToggledColor="Color.Primary" />
        </MudTooltip>
        <MudTooltip Text="@L["Copy"]">
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.ContentCopy" OnClick="@CopyAsync" />
        </MudTooltip>
        <MudTooltip Text="@L["Clear"]">
            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.DeleteSweep" OnClick="@Clear" />
        </MudTooltip>
    </div>
    <MudDivider />
    <div id="@ScrollContainerId" class="playzor-console-output flex-grow-1" style="min-height:0; overflow:auto; font-family:monospace; font-size:12px; white-space:pre-wrap; padding:4px 8px;">
        @foreach (var entry in Filtered)
        {
            <div class="playzor-console-line" style="@LineStyle(entry.Level)">@entry.Text</div>
        }
        @if (!Filtered.Any())
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["No output yet. Run your code — Console.WriteLine and JS console output show up here."]</MudText>
        }
    </div>
</div>
