<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="..\build\Playzor.props" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <PackageId>Playzor.Blazor</PackageId>
    <Title>Playzor Embed</Title>
    <Description>Embed a live, editable Blazor playground (playzor.net / try.mudex.org) into any page: as a Blazor component, or as the playzor-playground web component in plain html. No dependencies beyond Blazor itself.</Description>
    <PackageTags>Blazor;Playground;Embed;Playzor;WebComponent;Snippet;Live Code;MudBlazor</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- central package management pins 10.x, so older target frameworks need their own floor -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" VersionOverride="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" VersionOverride="9.0.0" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

</Project>
