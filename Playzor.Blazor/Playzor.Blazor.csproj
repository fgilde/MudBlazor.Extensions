<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- single target framework: the editor compiles user code with the roslyn version Try.Core pins -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Playzor.Blazor</PackageId>
    <Authors>Florian Gilde</Authors>
    <Description>The Playzor playground as a Blazor component: an in browser code editor with roslyn compilation, dockable panels and live preview, plus a lightweight embed component for the hosted playground.</Description>
    <PackageProjectUrl>https://playzor.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fgilde/MudBlazor.Extensions</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageTags>Blazor, Playground, Editor, Embed, Playzor, MudBlazor, Snippet, Live Code, Monaco, Roslyn</PackageTags>
    <Copyright>Copyright © $(Authors) 2026-$([System.DateTime]::Now.Year)</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <!-- the js function names and storage keys are used all over the package -->
    <Using Include="Playzor.Blazor.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MudBlazor.Extensions\MudBlazor.Extensions.csproj" />
    <ProjectReference Include="..\TryMudEx\Try.Core\Try.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

</Project>
